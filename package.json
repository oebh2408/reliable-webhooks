{
  "name": "reliable-webhooks",
  "version": "0.2.0",
  "description": "Send and receive webhooks with retries, backoff, signatures, idempotency and dead letters, plus a dashboard to manage them. Zero runtime dependencies.",
  "keywords": [
    "webhooks",
    "webhook",
    "retry",
    "backoff",
    "hmac",
    "signature",
    "idempotency",
    "dead-letter-queue",
    "outbox",
    "circuit-breaker",
    "standard-webhooks",
    "typescript",
    "dashboard"
  ],
  "author": "Oscar Benavides (https://ob0.dev)",
  "license": "MIT",
  "homepage": "https://github.com/oebh2408/reliable-webhooks#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oebh2408/reliable-webhooks.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "reliable-webhooks": "./dist/cli.js"
  },
  "files": [
    "dist",
    "dashboard/dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc && npm run build:dashboard",
    "build:dashboard": "vite build --config dashboard/vite.config.ts",
    "typecheck": "tsc -p tsconfig.examples.json && tsc -p dashboard/tsconfig.json",
    "test": "vitest run",
    "demo": "tsc && node dist/cli.js",
    "demo:svg": "tsc && node scripts/render-demo.mjs",
    "dashboard": "npm run build && node dist/cli.js dashboard",
    "dev:dashboard": "vite --config dashboard/vite.config.ts",
    "prepublishOnly": "npm run build && npm run typecheck && npm test",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
